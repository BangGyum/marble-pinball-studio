{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "es5" } },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useFilenamingConvention": { "level": "error", "options": { "filenameCases": ["kebab-case"] } }
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "server/**",
      "tests/**",
      "scripts/fairness.cjs",
      "scripts/fairness-jar.cjs",
      "scripts/licenses.cjs",
      "index.html",
      "lan.html",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "tsconfig.lan.json",
      "tsconfig.server.json"
    ]
  }
}
